{
  "name": "gmail-connector",
  "version": "1.0.0",
  "description": "CLI tool to manage Gmail accounts - organize, clean up, and analyze emails",
  "main": "dist/index.js",
  "bin": {
    "gmail-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
